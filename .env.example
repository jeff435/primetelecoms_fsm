# Copy this file to .env for local development.
# In production (Render), set these as Environment Variables in the dashboard.
# NEVER commit a file containing real credentials to Git.

# ─── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourapp.onrender.com

# ─── Database ──────────────────────────────────────────────────────────────────
# Render PostgreSQL external URL (Django sessions/admin only — NOT application data)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Firebase Web Client Config — project: planning-with-ai-f9dd4 ─────────────
# Source: Firebase Console → Project Settings → General → Your apps → Web app
# These are client-safe (they appear in browser JS) — still manage via env vars
# so they can be rotated without a code deployment.
FIREBASE_API_KEY=AIzaSyAXhvayFTtXjcNTJxINP-RlLb7eRMBaRmA
FIREBASE_AUTH_DOMAIN=planning-with-ai-f9dd4.firebaseapp.com
FIREBASE_PROJECT_ID=planning-with-ai-f9dd4
FIREBASE_STORAGE_BUCKET=planning-with-ai-f9dd4.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=768312939810
FIREBASE_APP_ID=1:768312939810:web:6fb8aabab5f1eebf2dc17b

# ─── Firebase Admin SDK (server-side only — NEVER expose to the browser) ───────
# Required for cryptographic ID token verification in production.
#
# How to generate:
#   1. Firebase Console → Project Settings → Service Accounts
#   2. Click "Generate new private key" → downloads a JSON file
#   3. Minify it:  python -c "import json,sys; print(json.dumps(json.load(open('key.json'))))"
#   4. Paste the single-line JSON string as the value below on Render
#   5. Delete the downloaded JSON file — NEVER commit it to Git
#
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"planning-with-ai-f9dd4",...}
