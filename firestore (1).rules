rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // The signed-in user's own Firestore profile (their role + organizationId
    // are read from HERE, never trusted from the client request itself).
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function myRole() {
      return myProfile().role;
    }
    function myOrg() {
      return myProfile().organizationId;
    }
    // A manager only counts as "manager" for access purposes while their
    // profile is active — this is what makes the Supreme Admin's "Revoke
    // Access" control take effect immediately for a manager, exactly the
    // same way active==false already does for technicians below.
    function isManager()    { return isAuth() && myRole() == "manager" && myProfile().active != false; }
    // A technician only counts as "technician" for access purposes while
    // their profile is active. This is what makes "Revoke Technician
    // Access" actually take effect immediately (their Firebase Auth
    // session may still be technically valid, but access.active == false
    // makes every job/report rule below fail closed for them at once).
    function isTechnician() { return isAuth() && myRole() == "technician" && myProfile().active != false; }
    function isCustomer()   { return isAuth() && myRole() == "customer"; }
    // The Supreme Admin — one per deployment (see /meta/adminBootstrap
    // below for the one-time claim that establishes this). Has every
    // manager power PLUS the sole ability to approve/reject/revoke
    // manager accounts.
    function isAdmin()      { return isAuth() && myRole() == "admin" && myProfile().active != false; }
    // Everywhere a manager could act, the admin can act too — this is the
    // single switch that broadens jobs/reports/tech_authorizations/staff
    // management to the admin role without duplicating every rule below.
    function isManagerLike() { return isManager() || isAdmin(); }
    // A newly self-registered manager sits here — created, but with none
    // of a manager's access — until the Supreme Admin approves them (see
    // isAdminManagerDecision() below, the only path that can move them
    // out of this role and into "manager").
    function isPendingManager() { return isAuth() && myRole() == "manager_pending"; }

    // Whether the one-time Supreme Admin claim is still available. Reads
    // the singleton /meta/adminBootstrap doc; treated as available if the
    // doc doesn't exist yet (nobody has claimed it) or explicitly says so.
    function adminBootstrapAvailable() {
      return !exists(/databases/$(database)/documents/meta/adminBootstrap)
          || get(/databases/$(database)/documents/meta/adminBootstrap).data.claimed != true;
    }

    // The ONLY email address(es) allowed to ever claim the Supreme Admin
    // bootstrap. This is the real security boundary for admin creation —
    // the matching ADMIN_ALLOWED_EMAILS list in js/data.js is just a
    // friendly client-side error message; a malicious client could edit
    // that file, but not this rule. Keep both lists in sync (same
    // email(s), lowercase) and redeploy this file whenever they change.
    function isAllowedAdminEmail(email) {
      return email in ["nevisjeff05@gmail.com"];
    }

    // The Supreme Admin approving, rejecting, revoking, or reinstating a
    // manager account. This is the ONLY path that can move a profile
    // between "manager_pending" and "manager" (in either direction) —
    // ordinary self-registration can create a manager_pending profile,
    // but nothing except this admin decision can turn it into a working
    // manager account. organizationId can never move; nothing but the
    // decision fields themselves can move alongside role/active.
    function isAdminManagerDecision() {
      return isAdmin()
          && resource.data.role in ["manager_pending", "manager"]
          && request.resource.data.role in ["manager_pending", "manager"]
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["role", "active", "approvedAt", "approvedBy", "rejectedAt", "rejectedBy",
                         "revokedAt", "revokedBy", "reinstatedAt", "reinstatedBy"]);
    }

    // A profile's role/organization cannot be changed by the client after
    // creation — this is what stops a customer or technician from editing
    // their own Firestore document to grant themselves the manager role.
    function roleAndOrgUnchanged() {
      return request.resource.data.role == resource.data.role
          && request.resource.data.organizationId == resource.data.organizationId;
    }

    // Lets a signed-in user correct THEIR OWN profile's organizationId back
    // to this deployment's single canonical org — nothing else. This exists
    // because this is a single-tenant deployment (every account is meant to
    // share DEFAULT_ORG_ID from js/data.js) and some older accounts were
    // written with a stale/mismatched organizationId before that was
    // enforced, which silently hid their jobs from everyone else's org-
    // scoped queries. It deliberately only allows moving TO the one known-
    // good value (never to an arbitrary org, never touching role), so it
    // can't be used to hop into someone else's tenant.
    function isOrgSelfHeal(uid) {
      return isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.organizationId == "org_primetelecoms"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["organizationId"]);
    }

    // A manager may flip a customer<->technician role for someone in their
    // own org — but this NEVER grants the "manager" role itself (granting
    // "manager" only ever happens via self-registration + admin approval,
    // or via the admin's direct manager_authorizations-backed create — see
    // /users create rule above) and it can never touch organizationId.
    // Only the role/audit/active fields may move; everything else about
    // the target profile is frozen in this op.
    function isManagerRoleToggle() {
      return isManagerLike()
          && myOrg() == resource.data.organizationId
          && request.resource.data.organizationId == resource.data.organizationId
          && resource.data.role in ["customer", "technician"]
          && request.resource.data.role in ["customer", "technician"]
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["role", "roleChangedAt", "roleChangedBy", "active"]);
    }

    // ── User Profiles (/users/{uid}) ──────────────────────────────────────────
    match /users/{userId} {
      // Read: your own profile, or anyone in your organization (needed for
      // name lookups — e.g. showing "Assigned Technician: John Mwangi").
      allow read: if isOwner(userId) || (isAuth() && myOrg() == resource.data.organizationId);

      // Create: only the account owner, and only for a role they're actually
      // allowed to self-assign:
      //  - "customer" → self-service registration. This is the ONLY role
      //    anyone can ever self-assign; every other role below requires a
      //    prior authorization written by someone who already has power.
      //  - "technician" → ONLY if a manager/admin has already authorized
      //    this exact email in /tech_authorizations with status
      //    "authorized". This is the server-side enforcement of "admin
      //    controls technician roles" — a client cannot fabricate a
      //    technician profile without it.
      //  - "admin" → ONLY while the one-time Supreme Admin claim is still
      //    unclaimed (see adminBootstrapAvailable() above) AND the email
      //    is on the isAllowedAdminEmail() allowlist above. There is no
      //    other path in these rules that can ever produce an "admin"
      //    profile — nobody, including an existing admin, can promote a
      //    second admin later. This is intentionally a single, narrow,
      //    identity-gated bootstrap door, not an ongoing admin-creation
      //    feature — and the claim screen itself is never linked in the
      //    app UI (see app.js), so it's both restricted and hidden.
      //  - "manager" → ONLY if the Supreme Admin has already authorized
      //    this exact email in /manager_authorizations with status
      //    "authorized" (see isAdmin()-gated write rule on that collection
      //    below). This is the server-side enforcement of "a manager is
      //    added by the admin" — a client cannot fabricate an active
      //    manager profile without the admin having authorized it first.
      allow create: if isOwner(userId) && (
        request.resource.data.role == "customer" ||
        (
          request.resource.data.role == "technician" &&
          exists(/databases/$(database)/documents/tech_authorizations/$(request.resource.data.email)) &&
          get(/databases/$(database)/documents/tech_authorizations/$(request.resource.data.email)).data.status == "authorized"
        ) ||
        (
          request.resource.data.role == "manager" &&
          exists(/databases/$(database)/documents/manager_authorizations/$(request.resource.data.email)) &&
          get(/databases/$(database)/documents/manager_authorizations/$(request.resource.data.email)).data.status == "authorized"
        ) ||
        (
          request.resource.data.role == "admin" &&
          adminBootstrapAvailable() &&
          isAllowedAdminEmail(request.resource.data.email)
        )
      );

      // Update: the owner can edit their own profile (role/org locked).
      // A manager or admin may ALSO update a technician's record in their
      // own org (e.g. flip `active` to revoke/reinstate them, fix their
      // employee ID) — but still can never change that technician's role
      // or org through this branch. A manager/admin may separately toggle
      // a customer's or technician's role via isManagerRoleToggle() below,
      // and the admin may separately decide a manager_pending/manager
      // account via isAdminManagerDecision() — those are the ONLY paths
      // in these rules allowed to change a `role` field, and neither can
      // ever produce or touch an "admin" or "manager_pending"→"manager"
      // change outside the admin's own explicit decision.
      allow update: if (
        roleAndOrgUnchanged() && (
          isOwner(userId) ||
          (isManagerLike() && myOrg() == resource.data.organizationId && resource.data.role == "technician")
        )
      ) || isManagerRoleToggle() || isOrgSelfHeal(userId) || isAdminManagerDecision();

      // Delete: ONLY the Supreme Admin, and ONLY for a non-admin profile in
      // their own org. This backs the "Delete Permanently" control on the
      // Staff and Manager Control Center screens (Users.purgeAccount in
      // data.js). An admin profile can never be deleted through the app —
      // that would let the one account with recovery power be destroyed by
      // a stray click, with no way back in short of the Firebase Console.
      // Note this removes the Firestore profile only; the person's Firebase
      // Authentication login is untouched (no client SDK can delete another
      // user's Auth account) and must be removed from the Firebase Console
      // if you want the email fully released.
      allow delete: if isAdmin()
                    && resource.data.role != "admin"
                    && myOrg() == resource.data.organizationId;
    }

    // ── Bootstrap Singleton (/meta/adminBootstrap) ─────────────────────────
    // Tracks whether the one-time Supreme Admin claim has been used yet.
    // Any signed-in user may read it (Auth.isAdminBootstrapAvailable() in
    // data.js checks it before allowing a claim attempt). It can only
    // ever be created as unclaimed, and can only ever flip false -> true
    // once — never back. The actual admin profile create (above) and this
    // flip happen together in a single client-side Firestore transaction,
    // so a race between two people claiming at the same instant can only
    // ever let one of them through — Firestore's optimistic concurrency
    // makes the loser's transaction retry, see it's already true, and abort.
    match /meta/adminBootstrap {
      allow read: if isAuth();
      // Created once, directly with claimed:true, by the winning side of
      // the claim transaction (see Auth.claimAdmin in data.js) — tied to
      // the claimant's own uid so at least the doc can't be silently
      // squatted by an unrelated write.
      allow create: if isAuth() && request.resource.data.claimed == true && request.resource.data.claimedBy == request.auth.uid;
      // Never allowed to flip back to false once claimed — this door
      // closes permanently after the first successful claim.
      allow update: if false;
    }

    // ── Private credentials (/users/{uid}/private/{docId}) ─────────────────
    // Holds the ONE piece of password data this system can honestly ever
    // show anyone back: the password a manager/admin themselves chose at
    // the moment they created a technician's account (see
    // managerCreateTechnician in data.js). It is NOT synced if the
    // technician later changes their own password — Firebase never
    // exposes a real password once a user has set one, by design, for
    // anyone. Kept in its own subcollection (rather than a field on
    // /users/{uid} itself) specifically so it is NEVER swept up by the
    // org-wide "read anyone in my org" rule on /users above — only the
    // account owner and a manager/admin in the same org can ever read it.
    match /users/{userId}/private/{docId} {
      allow read: if isOwner(userId) ||
        (isManagerLike() && myOrg() == get(/databases/$(database)/documents/users/$(userId)).data.organizationId);
      allow write: if isOwner(userId) || isManagerLike();
    }

    // ── Technician Authorizations (/tech_authorizations/{email}) ─────────────
    // This collection IS the access-control list for the technician role.
    match /tech_authorizations/{email} {
      allow read:  if isAuth(); // technicians self-check their own email during activation
      allow write: if isManagerLike(); // ONLY managers/admin may authorize or revoke technicians
    }

    // ── Manager Authorizations (/manager_authorizations/{email}) ─────────────
    // This collection IS the access-control list for the manager role,
    // mirroring tech_authorizations above. Write access is deliberately
    // narrower than the technician version: ONLY the Supreme Admin
    // (isAdmin(), not isManagerLike()) may authorize a manager — an
    // existing manager can never create a peer manager account.
    match /manager_authorizations/{email} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Jobs (/jobs/{jobId}) ───────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read: if isAuth() && myOrg() == resource.data.organizationId && (
        isManagerLike() ||
        (isTechnician() && resource.data.assignedTo == request.auth.uid) ||
        (isCustomer() && resource.data.customerId == request.auth.uid)
      );

      // Create: a manager can create/assign any job for their org.
      // A customer can create a job ONLY for themselves, unassigned and
      // pending — they cannot pre-assign a technician or fabricate someone
      // else's request.
      allow create: if isAuth() && request.resource.data.organizationId == myOrg() && (
        isManagerLike() ||
        (
          isCustomer() &&
          request.resource.data.customerId == request.auth.uid &&
          request.resource.data.status == "pending" &&
          !("assignedTo" in request.resource.data) 
        )
      );

      // Update: a manager can change anything (assign a technician, edit
      // details, cancel). A technician may ONLY touch their assigned job's
      // lifecycle fields (start it, and the completedAt stamp that comes
      // from filing a report) — never reassign it or edit the customer's
      // details. A customer may ONLY leave a review on their own completed
      // job, and only once (nothing else about the job can be touched
      // after submission).
      allow update: if isAuth() && myOrg() == resource.data.organizationId && (
        isManagerLike() ||
        (
          isTechnician() &&
          resource.data.assignedTo == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "startedAt", "completedAt"])
        ) ||
        (
          isCustomer() &&
          resource.data.customerId == request.auth.uid &&
          resource.data.status == "completed" &&
          !("rating" in resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["rating", "reviewComment", "reviewedAt"]) &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        )
      );
    }

    // ── Service Reports (/reports/{reportId}) ─────────────────────────────
    match /reports/{reportId} {
      // The customer branch checks resource.data.customerId directly
      // (denormalized onto the report at creation, see data.js
      // Reports.create) rather than get()-ing the parent job. A rule that
      // depends on get()-ing a DIFFERENT document can never be proven safe
      // for a LIST query — Firestore rejects the whole query outright,
      // not just the documents it can't verify — so customers listing
      // their own reports need a field on the report itself to filter on.
      allow read: if isAuth() && myOrg() == resource.data.organizationId && (
        isManagerLike() ||
        (isTechnician() && resource.data.technicianId == request.auth.uid) ||
        (isCustomer() && resource.data.customerId == request.auth.uid)
      );

      // Only the assigned technician can file the report for their own job,
      // and the customerId they stamp on it must match the job's real
      // customerId — this is the one place customerId is still checked via
      // get(), which is fine here because create/get validate a single
      // document, not a list query.
      allow create: if isAuth() && isTechnician()
        && request.resource.data.organizationId == myOrg()
        && request.resource.data.technicianId == request.auth.uid
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.assignedTo == request.auth.uid
        && request.resource.data.customerId == get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.customerId;

      // Only a manager can review/approve a submitted report.
      allow update: if isAuth() && isManagerLike() && myOrg() == resource.data.organizationId;
    }

    // ── Org Counters (/counters/{orgId}) ──────────────────────────────────────
    // Backs the atomic job-number sequence (see data.js `_reserveJobNumber`).
    // Anyone in the org can increment it (customers book jobs too), but only
    // ever their own org's counter.
    match /counters/{orgId} {
      allow read, write: if isAuth() && myOrg() == orgId;
    }

    // ── Organization documents (/organizations/{orgId}) ───────────────────────
    match /organizations/{orgId} {
      allow read, write: if isAuth() && myOrg() == orgId;

      match /{document=**} {
        allow read, write: if isAuth() && myOrg() == orgId;
      }
    }
  }
}
